Sub CreateFigureListFromSelection_V3_Fixed()
    '================================================================================
    ' ИСПРАВЛЕННАЯ ВЕРСИЯ МАКРОСА (V3)
    ' Заменен внешний объект ArrayList на встроенный VBA.Collection, чтобы избежать
    ' ошибки "Automation error" или "ActiveX component can't create object"
    ' на системах с ограничениями. Эта версия должна работать на любом ПК.
    '================================================================================

    ' --- НАСТРОЙКА ---
    ' Укажите ключевое слово-идентификатор для ваших рисунков (напр., "Рисунок", "Рис.").
    Const CAPTION_IDENTIFIER As String = "Рисунок"
    ' -----------------

    Dim sel As Selection
    Dim para As Paragraph
    Dim fld As Field
    Dim tbl As Table
    
    ' ИЗМЕНЕНИЕ №1: Используем встроенную коллекцию VBA
    Dim captionsData As Collection
    Set captionsData = New Collection
    
    Dim fullCaptionText As String
    Dim figureLabel As String
    Dim figureDescription As String

    Set sel = Application.Selection

    If sel.Type = wdSelectionIP Or sel.Range.Paragraphs.Count <= 1 Then
        MsgBox "Пожалуйста, выделите область с рисунками и подписями к ним.", vbInformation, "Ничего не выделено"
        Exit Sub
    End If

    For Each para In sel.Range.Paragraphs
        If para.Range.Fields.Count > 0 Then
            For Each fld In para.Range.Fields
                If fld.Type = wdFieldSequence Then
                    If InStr(1, fld.Code.Text, CAPTION_IDENTIFIER, vbTextCompare) > 0 Then
                        fullCaptionText = Trim(para.Range.Text)
                        figureLabel = Trim(fld.Result.Text)
                        figureDescription = Trim(Mid(fullCaptionText, Len(figureLabel) + 1))
                        
                        If Left(figureDescription, 1) = "." Or Left(figureDescription, 1) = ":" Then
                            figureDescription = Trim(Mid(figureDescription, 2))
                        End If

                        ' Добавление в коллекцию работает так же
                        captionsData.Add Array(figureLabel, figureDescription)
                        
                        Exit For
                    End If
                End If
            Next fld
        End If
    Next para

    If captionsData.Count = 0 Then
        MsgBox "В выделенной области не найдено подписей, вставленных через ""Вставить название"" с идентификатором '" & CAPTION_IDENTIFIER & "'.", _
               vbExclamation, "Подписи не найдены"
        Exit Sub
    End If

    sel.Collapse Direction:=wdCollapseEnd
    sel.TypeParagraph
    Set tbl = sel.Document.Tables.Add(Range:=sel.Range, NumRows:=captionsData.Count + 1, NumColumns:=2)

    With tbl
        .Style = "Сетка таблицы"
        .Borders.Enable = True
        .Cell(1, 1).Range.Text = "Обозначение"
        .Cell(1, 2).Range.Text = "Описание рисунка"
        .Rows(1).Range.Font.Bold = True
        .Rows(1).Range.ParagraphFormat.Alignment = wdAlignParagraphCenter
        
        ' ИЗМЕНЕНИЕ №2: Цикл для заполнения таблицы немного изменился
        Dim i As Long
        For i = 1 To captionsData.Count
            ' Коллекции нумеруются с 1, поэтому индекс строки теперь i + 1
            .Cell(i + 1, 1).Range.Text = captionsData(i)(0) ' Первый элемент массива
            .Cell(i + 1, 2).Range.Text = captionsData(i)(1) ' Второй элемент массива
        Next i
        
        .AutoFitBehavior (wdAutoFitContent)
        .Range.Cells.VerticalAlignment = wdCellAlignVerticalCenter
    End With
    
    MsgBox "Готово! Таблица со списком из " & captionsData.Count & " рисунков успешно создана.", vbInformation, "Операция завершена"

End Sub
