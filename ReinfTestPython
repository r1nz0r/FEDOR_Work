import csv
import math
import sys

# ==========================================
# НАСТРОЙКИ (Крути это дерьмо здесь)
# ==========================================

INPUT_FILENAME = 'forces.csv'
OUTPUT_FILENAME = 'reinforcement_result_asym.csv'

# ГЛАВНЫЙ РУБИЛЬНИК
# True  -> Симметричное армирование (As = As'). В обе грани суем максимум.
# False -> Несимметричное (экономичное). Считаем каждую грань честно.
IS_SYMMETRIC = False 

# Геометрия (мм)
REAL_H_Z = 1690.0 # Высота по Z
REAL_B_Y = 2200.0 # Ширина по Y
COVER_A = 70.0    # Привязка (мм)

# Материалы (B60, A500)
RB = 33.3     # МПа
RBT = 2.1     # МПа (для справки)
EB = 39500.0  # МПа
RS = 435.0    # МПа (Растяжение)
RSC = 435.0   # МПа (Сжатие)
ES = 200000.0 # МПа

# Единицы измерения Ансиса
FORCE_SCALE = 1.0       # Если N в Ньютонах -> 1.0
MOMENT_SCALE = 1000.0   # Если M в Н*м -> 1000.0 (перевод в Н*мм)

# ==========================================
# МАТЕМАТИЧЕСКАЯ МОЛОТИЛКА
# ==========================================

def solve_general_section(N_ansys, M_ansys, b, h, a, is_sym):
    """
    Универсальный решатель.
    """
    
    # 1. Приводим к СП 63
    # N_sp: (+) Сжатие, (-) Растяжение
    N_sp = -N_ansys 
    M_val = M_ansys 
    
    h0 = h - a
    
    # === ФИКС ОШИБКИ: СЧИТАЕМ x_R СРАЗУ, ЧТОБЫ ОН БЫЛ ВИДЕН ВЕЗДЕ ===
    omega = 0.85 - 0.008 * RB
    if omega < 0.37: omega = 0.37
    xi_R = omega / (1 + (RS/ES)/0.0035)
    x_R = xi_R * h0
    # ==============================================================
    
    # Отсечка шума
    if abs(N_sp) < 100 and abs(M_val) < 10000:
        return (0.0, 0.0)

    inverted = False
    if M_val < 0:
        M = -M_val
        inverted = True 
    else:
        M = M_val
        
    As_tens_res = 0.0
    As_comp_res = 0.0
    
    # --- СЖАТИЕ (N_sp >= 0) ---
    if N_sp >= 0:
        ea = max(h / 30.0, 10.0)
        e0 = M / N_sp if N_sp != 0 else 0
        e0 = max(e0, ea)
        
        e_s = e0 + (h/2 - a) 
        M_ext = N_sp * e_s
        
        # Уравнение: A*x^2 + B*x + C = 0
        A_k = 0.5 * RB * b
        B_k = -RB * b * h0
        C_k = M_ext
        
        D = B_k**2 - 4 * A_k * C_k
        
        need_comp_steel = False
        x_sol = 0.0 # Инициализируем нулем на всякий
        
        if D >= 0:
            x1 = (-B_k - math.sqrt(D)) / (2 * A_k)
            x_sol = x1
            
            if x_sol <= x_R:
                req_As = (RB * b * x_sol - N_sp) / RS
                As_tens_res = max(req_As, 0.0)
                As_comp_res = 0.0
            else:
                need_comp_steel = True
        else:
            need_comp_steel = True
            
        if need_comp_steel:
            x_eff = x_R
            Mb_max = RB * b * x_eff * (h0 - 0.5 * x_eff)
            
            if M_ext > Mb_max:
                dM = M_ext - Mb_max
                As_comp_res = dM / (RSC * (h0 - a))
            else:
                As_comp_res = 0.0 
            
            req_As = (RB * b * x_eff + RSC * As_comp_res - N_sp) / RS
            As_tens_res = max(req_As, 0.0)

    # --- РАСТЯЖЕНИЕ (N_sp < 0) ---
    else: 
        Nt = abs(N_sp)
        e0 = M / Nt if Nt != 0 else 0
        
        # Малый эксцентриситет
        if e0 <= (h/2 - a):
            e_comp_dist = (h/2 - a) - e0
            e_tens_dist = (h/2 - a) + e0
            z = h - 2*a
            
            As_tens_res = Nt * e_comp_dist / (RS * z)
            As_comp_res = Nt * e_tens_dist / (RS * z)
            
        else:
            # Большой эксцентриситет
            e_prime = e0 + h/2 - a
            M_ext = Nt * e_prime
            
            A_k = 0.5 * RB * b
            B_k = -RB * b * h0
            C_k = M_ext
            
            D = B_k**2 - 4 * A_k * C_k
            
            if D >= 0:
                 x1 = (-B_k - math.sqrt(D)) / (2 * A_k)
                 x_sol = x1
                 
                 # Вот тут раньше была жопа, если x_R не определен
                 if x_sol <= x_R:
                     As_comp_res = 0.0
                     As_tens_res = (RB * b * x_sol + Nt) / RS
                 else:
                     x_eff = x_R
                     Mb_max = RB * b * x_eff * (h0 - 0.5 * x_eff)
                     dM = M_ext - Mb_max
                     As_comp_res = dM / (RSC * (h0 - a))
                     As_tens_res = (RB * b * x_eff + RSC * As_comp_res + Nt) / RS
            else:
                 # Бетон не тащит
                 x_eff = x_R
                 Mb_max = RB * b * x_eff * (h0 - 0.5 * x_eff)
                 dM = M_ext - Mb_max
                 As_comp_res = dM / (RSC * (h0 - a))
                 As_tens_res = (RB * b * x_eff + RSC * As_comp_res + Nt) / RS
    
    # --- ВЫВОД ---
    if is_sym:
        final_As = max(As_tens_res, As_comp_res)
        return (final_As / 100.0, final_As / 100.0) 
    else:
        if inverted:
            return (As_tens_res / 100.0, As_comp_res / 100.0) 
        else:
            return (As_comp_res / 100.0, As_tens_res / 100.0) 


# ==========================================
# УМНЫЙ MAIN (Вставь это вместо старого main)
# ==========================================

def detect_format(filename):
    """Пытается угадать кодировку и разделитель"""
    encodings = ['utf-8-sig', 'cp1251', 'utf-8']
    
    for enc in encodings:
        try:
            with open(filename, 'r', encoding=enc) as f:
                first_line = f.readline()
                # Если прочиталось и не пусто
                if not first_line: continue
                
                # Считаем разделители
                semicolons = first_line.count(';')
                commas = first_line.count(',')
                
                delimiter = ';' if semicolons > commas else ','
                
                # Пробуем распарсить заголовки
                headers = first_line.strip().split(delimiter)
                # Если разбили хотя бы на 3 колонки - похоже на правду
                if len(headers) > 3:
                    return enc, delimiter
        except UnicodeDecodeError:
            continue
            
    return None, None

def main():
    print(f"--- РАСЧЕТ АРМИРОВАНИЯ (SMART MODE) ---")
    print(f"Симметричное армирование: {IS_SYMMETRIC}")
    
    # 1. Автодетект формата
    encoding, delimiter = detect_format(INPUT_FILENAME)
    
    if not encoding:
        print(f"ОШИБКА: Не могу прочитать файл {INPUT_FILENAME}. Проверь кодировку или путь.")
        sys.exit(1)
        
    print(f"Файл: {INPUT_FILENAME} | Кодировка: {encoding} | Разделитель: '{delimiter}'")
    
    try:
        with open(INPUT_FILENAME, 'r', encoding=encoding) as f_in, \
             open(OUTPUT_FILENAME, 'w', newline='', encoding='utf-8') as f_out:
            
            reader = csv.reader(f_in, delimiter=delimiter)
            writer = csv.writer(f_out, delimiter=';') # На выходе делаем ; чтобы Excel открыл сразу нормально
            
            # Читаем заголовки
            try:
                headers = next(reader)
            except StopIteration:
                print("Файл пустой!")
                sys.exit(1)

            clean_headers = [h.strip().lower() for h in headers]
            
            # ОТЛАДКА: Показываем, что нашли
            print(f"Вижу заголовки ({len(clean_headers)} шт): {clean_headers}")
            
            # Поиск колонок (немного смягчим условия поиска)
            c_set = -1; c_el = -1
            c_ni = -1; c_myi = -1; c_mzi = -1
            c_nj = -1; c_myj = -1; c_mzj = -1
            
            for i, h in enumerate(clean_headers):
                if 'set' in h: c_set = i
                elif 'elem' in h: c_el = i
                # Ищем точные совпадения или совпадения внутри
                elif h == 'ni' or 'ni' in h.split(): c_ni = i
                elif h == 'nj' or 'nj' in h.split(): c_nj = i
                # Моменты
                elif 'myi' in h: c_myi = i
                elif 'myj' in h: c_myj = i
                elif 'mzi' in h: c_mzi = i
                elif 'mzj' in h: c_mzj = i
            
            # Проверка критических колонок
            missing = []
            if c_ni == -1: missing.append("Ni")
            if c_myi == -1: missing.append("Myi")
            
            if missing:
                print(f"\n!!! ОШИБКА: Не найдены столбцы: {', '.join(missing)} !!!")
                print("Проверь названия в первой строке CSV файла.")
                sys.exit(1)
            
            # Заголовки выхода
            out_row = ['SetNum', 'ElemId', 
                       'AS_Top_I', 'AS_Bot_I', 'AS_Left_I', 'AS_Right_I',
                       'AS_Top_J', 'AS_Bot_J', 'AS_Left_J', 'AS_Right_J',
                       'Comment']
            writer.writerow(out_row)
            
            count = 0
            errors = 0
            for row in reader:
                if not row: continue
                try:
                    # Защита от коротких строк
                    if len(row) < len(headers): continue
                    
                    setn = row[c_set] if c_set != -1 else "1"
                    elid = row[c_el] if c_el != -1 else "0"
                    
                    # Данные I
                    Ni = float(row[c_ni].replace(',', '.')) * FORCE_SCALE # Замена запятой на точку для float
                    Myi = float(row[c_myi].replace(',', '.')) * MOMENT_SCALE
                    Mzi = float(row[c_mzi].replace(',', '.')) * MOMENT_SCALE
                    
                    # Данные J
                    Nj = float(row[c_nj].replace(',', '.')) * FORCE_SCALE
                    Myj = float(row[c_myj].replace(',', '.')) * MOMENT_SCALE
                    Mzj = float(row[c_mzj].replace(',', '.')) * MOMENT_SCALE
                    
                    # Расчет I
                    top_i, bot_i = solve_general_section(Ni, Myi, REAL_B_Y, REAL_H_Z, COVER_A, IS_SYMMETRIC)
                    left_i, right_i = solve_general_section(Ni, Mzi, REAL_H_Z, REAL_B_Y, COVER_A, IS_SYMMETRIC)
                    
                    # Расчет J
                    top_j, bot_j = solve_general_section(Nj, Myj, REAL_B_Y, REAL_H_Z, COVER_A, IS_SYMMETRIC)
                    left_j, right_j = solve_general_section(Nj, Mzj, REAL_H_Z, REAL_B_Y, COVER_A, IS_SYMMETRIC)
                    
                    writer.writerow([
                        setn, elid,
                        f"{top_i:.2f}", f"{bot_i:.2f}", f"{left_i:.2f}", f"{right_i:.2f}",
                        f"{top_j:.2f}", f"{bot_j:.2f}", f"{left_j:.2f}", f"{right_j:.2f}",
                        ""
                    ])
                    count+=1
                except Exception as e:
                    errors += 1
                    continue
            
            print(f"\nГотово. Обработано строк: {count}")
            if errors > 0:
                print(f"Пропущено битых строк: {errors}")
            print(f"Результат записан в: {OUTPUT_FILENAME}")

    except FileNotFoundError:
        print("Файл forces.csv не найден!")

if __name__ == "__main__":
    main()
